APP_IMAGE=ghcr.io/your-github-username/recruitment-job:latest

DB_URL=jdbc:postgresql://your-azure-postgres-host:5432/recruitment
DB_USERNAME=recruitment_user
DB_PASSWORD=replace_me

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

SERVER_PORT=8081
THYMELEAF_CACHE=true

APP_UPLOAD_DIR=/data/uploads
APP_UPLOAD_RESUME_MAX_SIZE=5242880
APP_UPLOAD_IMAGE_MAX_SIZE=2097152

LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SQL=WARN
